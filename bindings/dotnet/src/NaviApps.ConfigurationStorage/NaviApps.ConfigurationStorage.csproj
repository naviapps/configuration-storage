<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.ConfigurationStorage</PackageId>
    <Version>0.1.0</Version>
    <Description>Opaque transactional configuration storage backed by Rust and SQLite.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable Condition="'$(SdkNativeRuntimeAssets)' == ''">false</IsPackable>
    <PathMap>$(MSBuildProjectDirectory)=/configuration-storage/dotnet</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(ConfigurationStorageNativeLibrary)" Condition="'$(ConfigurationStorageNativeLibrary)' != ''"
          CopyToOutputDirectory="Always" Pack="false">
      <Link Condition="'$(OS)' == 'Windows_NT'">configuration_storage.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libconfiguration_storage.dylib</Link>
    </None>
    <None Include="$(SdkNativeRuntimeAssets)/**/*" Condition="'$(SdkNativeRuntimeAssets)' != ''"
          Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
